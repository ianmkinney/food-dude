{
  "name": "amplifood",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "node scripts/copy-pdfjs.js && expo start --web",
    "build:web": "node scripts/copy-pdfjs.js && expo export --platform web && node scripts/web-postexport.js",
    "preview:web": "npx --yes serve@14 dist --single --listen 8080",
    "brand:assets": "python3 scripts/generate-brand-assets.py",
    "typecheck": "tsc --noEmit",
    "verify:api": "node scripts/verify-api-handlers.mjs",
    "party-db:migrate": "node scripts/party-db/migrate.mjs",
    "test:web-db-tabs": "node scripts/test-web-db-two-tabs.mjs",
    "test:ampi": "node scripts/test-ampi-recipe-followup.mjs"
  },
  "dependencies": {
