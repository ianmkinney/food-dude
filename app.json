{
  "expo": {
    "name": "AmpliFood",
    "slug": "food-dude",
    "version": "1.0.0",
    "scheme": "fooddude",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FEFCF7"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.fooddude.app",
      "infoPlist": {
        "NSCameraUsageDescription": "AmpliFood needs access to your camera to scan barcodes and take photos of ingredients.",
        "NSPhotoLibraryUsageDescription": "AmpliFood needs access to your photo library to save and share recipe images.",
        "NSPhotoLibraryAddUsageDescription": "AmpliFood needs permission to save photos to your library.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FEFCF7"
      },
      "package": "com.fooddude.app",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.ACCESS_MEDIA_LOCATION",
        "android.permission.READ_MEDIA_AUDIO"
      ],
      "edgeToEdgeEnabled": true
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png",
      "name": "AmpliFood",
      "shortName": "AmpliFood",
      "description": "A kitchen companion with a little attitude: recipes, meal plans, pantry, grocery lists and an AI chef.",
      "themeColor": "#EB6A1C",
      "backgroundColor": "#FBF4E8"
    },
    "plugins": [
      "expo-barcode-scanner",
      "expo-sqlite",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow AmpliFood to access your camera to scan barcodes and take photos."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow AmpliFood to access your photos to share recipe images.",
          "cameraPermission": "Allow AmpliFood to use your camera to take photos of ingredients."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Allow AmpliFood to save photos to your library.",
          "savePhotosPermission": "Allow AmpliFood to save photos.",
          "isAccessMediaLocationEnabled": true
        }
      ],
      [
        "expo-share-intent",
        {
          "ios": {
            "activationRules": {
              "NSExtensionActivationSupportsWebURLWithMaxCount": 1,
              "NSExtensionActivationSupportsText": true,
              "NSExtensionActivationSupportsImageWithMaxCount": 10
            }
          },
          "android": {
            "intentFilters": [
              {
                "action": "android.intent.action.SEND",
                "data": {
                  "mimeType": "text/plain"
                }
              },
              {
                "action": "android.intent.action.SEND",
                "data": {
                  "mimeType": "image/*"
                }
              },
              {
                "action": "android.intent.action.SEND_MULTIPLE",
                "data": {
                  "mimeType": "image/*"
                }
              }
            ]
          }
        }
      ],
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "8ae8b6b6-6669-4f66-bd80-e16bbe8dc268"
      }
    }
  }
}
