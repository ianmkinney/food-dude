# AI provider keys are entered in-app (Account) and stored on-device
# in SecureStore. Do not put Claude / OpenAI / Grok / Gemini keys here.
# A shared EXPO_PUBLIC_* key would be compiled into the JS bundle.

# Open Food Facts API (no key required, but you can use a custom user agent)
EXPO_PUBLIC_FOOD_API_USER_AGENT=FoodDude/1.0
